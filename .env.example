# Example environment configuration.
# Copy this file to .env and fill in your own values:
#   cp .env.example .env

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/linkgraveyard
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/<dbname>
MONGODB_URI=mongodb://127.0.0.1:27017/linkgraveyard

# Secret used to sign JWTs. Use a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Port the API listens on.
PORT=5000

# Frontend origin(s) allowed to call the API (comma-separated).
FRONTEND_URL=http://localhost:5173

# Set to "production" to serve the built React app from the Express server.
NODE_ENV=development
